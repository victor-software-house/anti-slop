{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": ["mise-tasks/**/*.ts", "test/**/*.test.ts"],
	"project": [
		"src/**/*.ts",
		"test/**/*.ts",
		"mise-tasks/**/*.ts",
		".changeset/**/*.ts",
		"*.config.ts"
	],
	"ignoreExportsUsedInFile": true,
	"ignoreBinaries": ["mise"],
	"ignoreDependencies": ["@biomejs/biome", "@changesets/cli", "@commitlint/cli"],
	"ignoreIssues": {
		"src/shared/dictionary-types.ts": ["exports"]
	}
}
